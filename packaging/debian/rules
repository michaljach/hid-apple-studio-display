#!/usr/bin/make -f
include /usr/share/dpkg/pkg-info.mk

PKG := hid-apple-studio-display-dkms
MOD := hid-apple-studio-display

%:
	dh $@ --with dkms

# DKMS builds the module on the target system; nothing to build or clean here
override_dh_auto_configure override_dh_auto_build override_dh_auto_test override_dh_auto_clean:
	@true

override_dh_auto_install:
	dh_install -p $(PKG) $(MOD).c Makefile usr/src/$(MOD)-$(DEB_VERSION_UPSTREAM)/
	dh_install -p $(PKG) contrib/90-hid-apple-studio-display.rules usr/lib/udev/rules.d/
	dh_install -p $(PKG) contrib/asd-als-role contrib/asd-bind-orientation usr/lib/udev/
	dh_install -p $(PKG) contrib/asd-autorotate usr/bin/
	dh_install -p $(PKG) contrib/asd-autorotate.service usr/lib/systemd/user/

override_dh_dkms:
	dh_dkms -V $(DEB_VERSION_UPSTREAM)
