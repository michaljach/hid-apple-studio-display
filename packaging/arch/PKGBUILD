# Maintainer: Michal Jach <michaljach@gmail.com>
pkgname=hid-apple-studio-display-dkms
_pkgname=hid-apple-studio-display
pkgver=1.2.0
pkgrel=1
pkgdesc="Brightness (backlight) and orientation sensor driver for the Apple Studio Display / Studio Display XDR (DKMS)"
arch=('any')
url="https://github.com/michaljach/hid-apple-studio-display"
license=('GPL-2.0-only')
depends=('dkms')
optdepends=('python-gobject: GNOME brightness slider without re-plugging (asd-gnome-rescan), asd-autorotate'
            'iio-sensor-proxy: automatic brightness from the ambient light sensor')
source=("$_pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('21fba604dd5ada43f3b07d4badd2ea4f94a432422732abc0044803fbf9acb149')

package() {
	cd "$_pkgname-$pkgver"
	install -Dm644 -t "$pkgdir/usr/src/$_pkgname-$pkgver" "$_pkgname.c" Makefile dkms.conf
	install -Dm644 -t "$pkgdir/usr/lib/udev/rules.d" contrib/90-hid-apple-studio-display.rules
	install -Dm755 -t "$pkgdir/usr/lib/udev" contrib/asd-als-role contrib/asd-bind-orientation
	install -Dm755 -t "$pkgdir/usr/bin" contrib/asd-autorotate contrib/asd-gnome-rescan
	install -Dm644 -t "$pkgdir/usr/lib/systemd/user" contrib/asd-autorotate.service contrib/asd-gnome-rescan.service
	install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md
	install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
